<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:media="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="SkyeShowAndroid.MainPage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{DynamicResource BackgroundColor}">

    <Grid RowDefinitions="*,Auto" Padding="20">

        <VerticalStackLayout Grid.Row="0" Spacing="15">

            <Label x:Name="AppHeaderLabel"
                   Text="Skye Show Android"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource TextColor}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,5" />

            <Button Text="Play Random Video"
                    FontSize="20"
                    BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                    TextColor="{DynamicResource ButtonTextColor}"
                    Clicked="OnPlayClicked"
                    HeightRequest="100" />

            <Border
                StrokeThickness="0"
                BackgroundColor="{DynamicResource BackgroundColor}"
                HeightRequest="300"
                WidthRequest="300"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <media:MediaElement
                    x:Name="Player"
                    ShouldAutoPlay="False"
                    Aspect="AspectFit"
                    BackgroundColor="Transparent" />
            </Border>

            <Label x:Name="NowPlayingLabel"
                   Text=""
                   TextColor="{DynamicResource TextColor}"
                   FontSize="10"
                   Margin="5,-10"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   IsVisible="True" />

            <Button Text="FullScreen"
                    FontSize="20"
                    BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                    TextColor="{DynamicResource ButtonTextColor}"
                    Clicked="OnFullscreenClicked"
                    HeightRequest="100" />

        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="Settings"
                FontSize="20"
                BackgroundColor="{DynamicResource ButtonBackgroundColor}"
                TextColor="{DynamicResource ButtonTextColor}"
                Clicked="OnSettingsClicked"
                HeightRequest="100" />

    </Grid>
</ContentPage>